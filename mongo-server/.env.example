# Copy to .env and fill in. .env is gitignored - never commit real credentials.
#
# These are the same two variables backend/config.py reads, so the Node server
# and the Python backend can share one .env contract.

# MongoDB connection string.
# Local mongod (no auth) is the default if this is unset:
MONGODB_URI=mongodb://localhost:27017

# For a cluster, use the SRV form and keep the credentials out of source
# control. In deployment, inject this from your secret store (e.g. AWS Secrets
# Manager) rather than a file on disk:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority

MONGODB_DB_NAME=healthcare_chatbot

# Port the health server listens on. Must match API_BASE in
# frontend/src/constants.js.
PORT=5000
